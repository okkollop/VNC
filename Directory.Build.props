<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Infollop</Company>
    <Product>InfollopAssist</Product>
    <Copyright>© 2026 Infollop. Todos los derechos reservados.</Copyright>
    <!-- Versión de InfollopAssist: subirla en cada publicación (las actualizaciones automáticas la comparan) -->
    <Version>1.0.0</Version>
  </PropertyGroup>
</Project>
